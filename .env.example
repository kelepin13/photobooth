# All variables below are OPTIONAL. The app runs with zero config using
# in-memory room state and local-disk strip storage — these just swap in
# more durable backends when you're ready for them.

# --- Redis-backed room store (state survives restarts, works across
#     multiple server instances). Leave unset to use in-memory storage. ---
# REDIS_URL=redis://default:password@your-redis-host:6379

# --- S3-compatible object storage for published strips (links survive
#     redeploys). Leave unset to fall back to local disk (STRIPS_DIR). ---
# S3_BUCKET=my-photobooth-bucket
# S3_ACCESS_KEY_ID=xxxxx
# S3_SECRET_ACCESS_KEY=xxxxx
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # omit for real AWS S3
# S3_PUBLIC_URL_BASE=https://pub-xxxxx.r2.dev                 # your bucket's public URL/CDN

# --- Public address used in QR codes and published links. Set it when the
#     app runs behind a proxy, or to your LAN IP so phones can join in dev
#     (e.g. http://192.168.1.10:3000). Defaults to the request's own origin. ---
# PUBLIC_URL=https://photobooth.example.com

# --- Folder for published strips when S3 isn't configured (default: data/strips).
#     Put it on a persistent volume to keep links working across redeploys. ---
# STRIPS_DIR=/app/data/strips
